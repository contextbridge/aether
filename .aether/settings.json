{
  "agents": [
    {
      "name": "Cheap",
      "description": "ZAI GLM-5 with high reasoning",
      "model": "zai:glm-5.3",
      "reasoningEffort": "high",
      "userInvocable": true,
      "prompts": [".aether/SYSTEM.md", "AGENTS.md"],
      "mcps": ["mcp.json"]
    },
    {
      "name": "Explorer",
      "description": "Explores codebases to find relevant files, patterns, and integration points",
      "model": "deepseek:deepseek-v4-flash",
      "userInvocable": false,
      "agentInvocable": true,
      "prompts": [".aether/agents/codebase-explorer/AGENTS.md"],
      "mcps": [
        {
          "type": "inline",
          "servers": {
            "coding": {
              "type": "in-memory",
              "args": [
                "--rules-dir",
                "${HOME}/.claude/rules",
                "--rules-dir",
                "${WORKSPACE}/.claude/rules",
                "--rules-dir",
                "${HOME}/.agents/rules",
                "--rules-dir",
                "${WORKSPACE}/.agents/rules"
              ],
              "input": null
            }
          }
        }
      ],
      "tools": {
        "allow": [
          {
            "readOnly": true
          },
          "plan__*",
          "skills__*",
          "tasks__*",
          "survey__*"
        ],
        "deny": ["subagents__*"]
      }
    }
  ]
}
