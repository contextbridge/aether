{
  "servers": {
    "coding": {
      "type": "in-memory",
      "args": ["--rules-dir", "./.aether/skills"]
    },
    "skills": {
      "type": "in-memory",
      "args": ["--dir", "./.aether/skills"]
    },
    "tasks": {
      "type": "in-memory"
    },
    "subagents": {
      "type": "in-memory"
    },
    "review": {
      "type": "in-memory"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["chrome-devtools-mcp@latest"],
      "deferTools": true
    }
  }
}
