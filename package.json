{
  "name": "aether-monorepo",
  "private": true,
  "scripts": {
    "sdk:build": "pnpm --filter @aether-agent/sdk build",
    "sdk:typecheck": "pnpm --filter @aether-agent/sdk typecheck",
    "sdk:test": "pnpm --filter @aether-agent/sdk test",
    "sdk:e2e": "pnpm --filter @aether-agent/sdk e2e",
    "sdk:generate-types": "pnpm --filter @aether-agent/sdk generate:types",
    "evals:build": "pnpm --filter @aether-agent/evals build",
    "evals:typecheck": "pnpm --filter @aether-agent/evals typecheck",
    "evals:test": "pnpm --filter @aether-agent/evals test",
    "website:dev": "pnpm --filter @aether-agent/website dev",
    "website:build": "pnpm --filter @aether-agent/website build",
    "website:preview": "pnpm --filter @aether-agent/website preview",
    "website:check": "pnpm --filter @aether-agent/website astro check",
    "desktop:generate-types": "cargo test -p desktop-app --lib tests::exports_typescript_bindings -- --exact",
    "desktop:dev": "pnpm --filter @aether-agent/desktop-app tauri:dev",
    "desktop:build": "pnpm --filter @aether-agent/desktop-app tauri:build",
    "desktop:preview": "pnpm --filter @aether-agent/desktop-app preview",
    "desktop:typecheck": "pnpm --filter @aether-agent/desktop-app build",
    "desktop:test": "pnpm --filter @aether-agent/desktop-app test",
    "fmt": "prettier --write \"packages/**/*.{ts,mts,cts,mjs,cjs,js,jsx,json,astro,css}\"",
    "fmt-check": "prettier --check \"packages/**/*.{ts,mts,cts,mjs,cjs,js,jsx,json,astro,css}\""
  },
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1"
  }
}
