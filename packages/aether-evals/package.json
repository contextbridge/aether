{
  "name": "@aether-agent/evals",
  "version": "0.3.0",
  "description": "Evaluation harness for the Aether agent SDK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contextbridge/aether.git",
    "directory": "packages/aether-evals"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "compile": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aether-agent/sdk": "^0.4.1",
    "testcontainers": "^12.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.31",
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24"
  }
}
