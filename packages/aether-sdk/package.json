{
  "name": "@aether-agent/sdk",
  "version": "0.2.8",
  "description": "TypeScript SDK for the Aether agent CLI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contextbridge/aether.git",
    "directory": "packages/aether-sdk"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./evals": {
      "types": "./dist/evals/index.d.ts",
      "import": "./dist/evals/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm generate:types && tsc -p tsconfig.build.json",
    "typecheck": "pnpm generate:types && tsc -p tsconfig.json --noEmit",
    "test": "pnpm generate:types && vitest run",
    "generate:types": "node scripts/generate-types.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@aether-agent/cli": "^0.7.14",
    "@agentclientprotocol/sdk": "^0.25.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^25.9.3",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24"
  }
}
