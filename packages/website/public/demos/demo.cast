[0.019, "o", "\u001b[?2026h\u001b[2B\u001b[29A\r\u001b[J\u001b[38;2;92;112;104m│ I found two Rust files. Let me read them to see what's in there, then I can introduce an intentional error.\u001b[39m\r\n\r\n\r\u001b[J\u001b[38;2;167;192;128m✓\u001b[39m Read file\u001b[38;2;92;112;104m (lib.rs, 95 lines)\u001b[39m\r\n\u001b[38;2;167;192;128m✓\u001b[39m Read file\u001b[38;2;92;112;104m (error.rs, 50 lines)\u001b[39m\r\n\r\n\u001b[38;2;92;112;104m│ Now I'll introduce a simple compiler error. I'll introduce a type mismatch error in the `add` function by trying to re\u001b[39m\r\n\u001b[38;2;92;112;104mturn a string instead of a u64.\u001b[39m\r\n\r\nI'll introduce a compiler error in the \u001b[38;2;143;188;176madd\u001b[39m function. Let me break it by returning the wrong type:\r\n\r\n\u001b[38;2;167;192;128m✓\u001b[39m Edit file\u001b[38;2;92;112;104m (lib.rs)\u001b[39m\r\n\u001b[38;2;92;112;104m  31 \u001b[3m\u001b[38;2;92;110;101m/// ```\u001b[0m\u001b[39m\u001b[49m                                                \u001b[38;2;92;112;104m  31 \u001b[3m\u001b[38;2;92;110;101m/// ```\u001b[0m\u001b[39m\u001b[49m                                                \r\n"]
[0.000, "o", "\u001b[38;2;92;112;104m  32 \u001b[38;2;143;188;176m#[\u001b[38;2;212;221;214mmust_use\u001b[38;2;143;188;176m]\u001b[39m                                            \u001b[38;2;92;112;104m  32 \u001b[38;2;143;188;176m#[\u001b[38;2;212;221;214mmust_use\u001b[38;2;143;188;176m]\u001b[39m                                            \r\n\u001b[38;2;92;112;104m  33 \u001b[38;2;196;167;231mpub\u001b[38;2;212;221;214m \u001b[38;2;196;167;231mfn\u001b[38;2;212;221;214m \u001b[38;2;130;177;204madd\u001b[38;2;143;188;176m(\u001b[3m\u001b[38;2;212;221;214mleft\u001b[0m\u001b[38;2;143;188;176m\u001b[49m:\u001b[38;2;212;221;214m \u001b[38;2;196;167;231mu64\u001b[38;2;212;221;214m, \u001b[3mright\u001b[0m\u001b[38;2;143;188;176m\u001b[49m:\u001b[38;2;212;221;214m \u001b[38;2;196;167;231mu64\u001b[38;2;143;188;176m)\u001b[38;2;212;221;214m \u001b[38;2;143;188;176m->\u001b[38;2;212;221;214m \u001b[38;2;196;167;231mu64\u001b[38;2;212;221;214m \u001b[38;2;143;188;176m{\u001b[39m             \u001b[38;2;92;112;104m  33 \u001b[38;2;196;167;231mpub\u001b[38;2;212;221;214m \u001b[38;2;196;167;231mfn\u001b[38;2;212;221;214m \u001b[38;2;130;177;204madd\u001b[38;2;143;188;176m(\u001b[3m\u001b[38;2;212;221;214mleft\u001b[0m\u001b[38;2;143;188;176m\u001b[49m:\u001b[38;2;212;221;214m \u001b[38;2;196"]
[0.000, "o", ";167;231mu64\u001b[38;2;212;221;214m, \u001b[3mright\u001b[0m\u001b[38;2;143;188;176m\u001b[49m:\u001b[38;2;212;221;214m \u001b[38;2;196;167;231mu64\u001b[38;2;143;188;176m)\u001b[38;2;212;221;214m \u001b[38;2;143;188;176m->\u001b[38;2;212;221;214m \u001b[38;2;196;167;231mu64\u001b[38;2;212;221;214m \u001b[38;2;143;188;176m{\u001b[39m             \r\n\u001b[38;2;92;112;104m  34 \u001b[38;2;212;221;214m\u001b[48;2;46;25;25m    left \u001b[38;2;211;160;124m+\u001b[38;2;212;221;214m right\u001b[39m                                       \u001b[38;2;92;112;104m\u001b[49m  34 \u001b[38;2;212;221;214m\u001b[48;2;33;38;25m    \u001b[38;2;143;188;176m\"\u001b[38;2;167;192;128mthis is a string, not a number\u001b[38;2;143;188;176m\"\u001b[39m                   \u001b[49m\r\n\u001b[38;2;92;112;104m  35 \u001b[38;2;212;221;214m}\u001b[39m                                                      \u001b[38;2;92;112;104m  35 \u001b[38;2;212;221;214m}\u001b[39m                                                      \r\n\u001b[38;2;92;112;104m  36 \u001b[39m                                                       \u001b[38;2;92;112;104m  36 \u001b[39m                                                       \r\n"]
