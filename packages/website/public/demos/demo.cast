[0.001, "o", "\u001b[?2026h\u001b[2B\u001b[29A\r\u001b[J\r\n\u001b[1mFoo\u001b[0m\u001b[39m\u001b[49m is a simple Rust calculator library template that demonstrates basic Rust patterns including error handling, documen\r\n\r\u001b[Jtation, and testing.\r\n\r\n\u001b[1m\u001b[38;2;223;194;150m### Functionality Provided\u001b[0m\u001b[39m\u001b[49m\r\n\r\n\r\n\u001b[38;2;92;112;104m1. \u001b[38;2;143;188;176madd(left: u64, right: u64) -> u64\u001b[39m - A standalone function that adds two unsigned 64-bit integers.\r\n\r\n\r\n\r\n"]
[0.000, "o", "\u001b[38;2;92;112;104m2. \u001b[38;2;143;188;176mCalculator\u001b[1m\u001b[39m struct\u001b[0m\u001b[39m\u001b[49m - A simple stateless calculator with methods:\r\n\r\n\r\n\u001b[38;2;92;112;104m  - \u001b[38;2;143;188;176mnew()\u001b[39m - Constructor\r\n\r\n\u001b[38;2;92;112;104m  - \u001b[38;2;143;188;176madd(a, b)\u001b[39m - Instance method wrapping the add function\r\n\r\n\u001b[38;2;92;112;104m  - \u001b[38;2;143;188;176msubtract(a, b)\u001b[39m - Safe subtraction that returns an error on underflow (using \u001b[38;2;143;188;176mResult\u001b[39m)\r\n\r\n\r\n\u001b[38;2;92;112;104m3. \u001b[1m\u001b[39mError Handling:\u001b[0m\u001b[39m\u001b[49m\r\n\r\n\r\n"]
[0.000, "o", "\u001b[38;2;92;112;104m  - \u001b[38;2;143;188;176mError::Underflow { a, b }\u001b[39m - Custom error for subtraction underflow\r\n\r\n\u001b[38;2;92;112;104m  - \u001b[39m\r\n\u001b[38;2;130;177;204m⣽\u001b[38;2;135;144;140m Tip: Wisp supports custom themes — drop a .tmTheme in ~/.wisp/themes/\u001b[3m\u001b[38;2;92;112;104m  (esc to interrupt)\u001b[0m\u001b[39m\u001b[49m\r\n\u001b[38;2;92;112;104m╭──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[39m\r\n\u001b[38;2;92;112;104m│\u001b[39m \u001b[38;2;212;221;214m> \u001b[39m                                                                                                                   \u001b[38;2;92;112;104m│\u001b[39m\r\n\u001b[38;2;92;112;104m╰───────────────────────────────────"]
