[0.001, "o", "\u001b[?2026h\u001b[2B\u001b[29A\r\u001b[J\u001b[38;2;92;112;104m  33 \u001b[38;2;196;167;231mpub\u001b[38;2;212;221;214m \u001b[38;2;196;167;231mfn\u001b[38;2;212;221;214m \u001b[38;2;130;177;204madd\u001b[38;2;143;188;176m(\u001b[3m\u001b[38;2;212;221;214mleft\u001b[0m\u001b[38;2;143;188;176m\u001b[49m:\u001b[38;2;212;221;214m \u001b[38;2;196;167;231mu64\u001b[38;2;212;221;214m, \u001b[3mright\u001b[0m\u001b[38;2;143;188;176m\u001b[49m:\u001b[38;2;212;221;214m \u001b[38;2;196;167;231mu64\u001b[38;2;143;188;176m)\u001b[38;2;212;221;214m \u001b[38;2;143;188;176m->\u001b[38;2;212;221;214m \u001b[38;2;196;167;231mu64\u001b[38;2;212;221;214m \u001b[38;2;143;188;176m{\u001b[39m             \u001b[38;2;92;112;104m  33 \u001b[38;2;196;167;231mpub\u001b[38;2;212;221;214m \u001b[38;2;196;167;231mfn\u001b[38;2;212;221;214m \u001b[38;2;130;177;204madd\u001b[38;2;143;188;176m(\u001b[3m\u001b[38;2;212;221;214mleft\u001b[0m\u001b[38;2;143;188;176m\u001b[49m:\u001b[38;2;212;221;214m \u001b[38;2;196;167;231mu64\u001b[38;2;212;221;214m, \u001b[3mright\u001b[0m\u001b[38;2;143;188;176m\u001b[49m:\u001b[38;2;212;221;214m \u001b[38;2;196;167;231mu64\u001b[38;2;143;188;176m)\u001b[38;2;212;221;214m \u001b[38;2;143;188;176m->\u001b[38;2;212;221;214m \u001b[38;2;196;167;231mu64\u001b[38;2;212;221;214m \u001b[38;2;143;188;176m{\u001b[39m"]
