#!/usr/bin/env bash

set -euo pipefail

prompt="$RUNNER_TEMP/prompt.md"

case "$MODE" in
    plan) cat .aether/github-agent/plan.md > "$prompt" ;;
    implement) cat .aether/github-agent/issue.md > "$prompt" ;;
    pr) cat .aether/github-agent/pr-comment.md > "$prompt" ;;
esac

if [[ "$MODE" == "pr" ]]; then
    printf '\n## Pull request #%s\n\nIt targets `%s`. Run `git diff origin/%s...HEAD` to see what it changes.\n' \
        "$NUMBER" "$BASE" "$BASE" >> "$prompt"
else
    {
        printf '\n## Issue #%s: %s\n\n' "$NUMBER" "$ISSUE_TITLE"
        printf '%s\n' "$ISSUE_BODY"
    } >> "$prompt"
fi

if [[ "$MODE" == "plan" ]]; then
    printf '\nWrite your plan to `%s`.\n' "$PLAN_FILE" >> "$prompt"
fi

if [[ -n "$COMMENT_BODY" ]]; then
    {
        printf '\n## Comment from @%s\n\n' "$COMMENT_AUTHOR"
        printf '%s\n' "$COMMENT_BODY"
    } >> "$prompt"

    if [[ -n "$COMMENT_PATH" ]]; then
        {
            printf '\nThey left this as an inline review comment on `%s` around line %s:\n\n' \
                "$COMMENT_PATH" "$COMMENT_LINE"
            printf '```diff\n'
            printf '%s\n' "$COMMENT_DIFF_HUNK"
            printf '```\n'
        } >> "$prompt"
    fi
fi

printf '\nWrite your commit message to `%s` (see the `commit-message` skill).\n' \
    "$COMMIT_MESSAGE_FILE" >> "$prompt"

echo "path=$prompt" >> "$GITHUB_OUTPUT"
