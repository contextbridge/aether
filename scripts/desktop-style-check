#!/usr/bin/env bash
set -euo pipefail
src="crates/desktop/src"
status=0
report() {
    echo "$1:"
    echo "$2"
    status=1
}
matches=$(grep -rnE '\.(text_(xs|sm|base|lg|xl|2xl)|rounded_(sm|md|lg|xl))\(\)|_[0-9]p5\(\)' "$src" || true)
[ -n "$matches" ] && report "Use Typography and ui::tokens radii instead" "$matches"
matches=$(grep -rnoE 'px\([0-9]+(\.[0-9]+)?\)' "$src" \
    | grep -vE 'px\((0|1|2)(\.0)?\)' \
    | awk -F'px\\(' '{ value = $2; sub(/\)$/, "", value); if (value % 4 != 0) print }' || true)
[ -n "$matches" ] && report "Keep px() literals on the 4px grid" "$matches"
names=$(grep -rhoE 'rem\([A-Z][A-Z0-9_]*\)' "$src" | sed -E 's/rem\((.*)\)/\1/' | sort -u)
matches=$(for name in $names; do
    grep -rnE "const $name: f32 = [0-9.]+;" "$src" \
        | grep -vE 'const [A-Z][A-Z0-9_]*_OFF_GRID:' \
        | awk -F'= ' '{ value = $2; sub(/;.*/, "", value); if (value > 2 && value % 4 != 0) print }' || true
done)
[ -n "$matches" ] && report "Keep the constants rem() takes on the 4px grid" "$matches"
exit "$status"
